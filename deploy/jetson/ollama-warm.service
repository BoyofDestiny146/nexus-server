[Unit]
Description=Warm Watcher chat model (qwen2.5:3b) into GPU; leave vision/embed on demand
After=ollama.service network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Settle delay so the docker stack's ASR/VAD GPU load finishes first.
ExecStartPre=/bin/sleep 60
ExecStart=/usr/local/bin/cc-warm-models.sh

[Install]
WantedBy=multi-user.target
