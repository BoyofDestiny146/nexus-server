# CareConnect production environment — .env.example
#
# Copy to .env and fill in values before running `docker compose up`.
# This file is committed to the repo as documentation. Never commit .env.
#
# Secrets (passwords, keys) must NOT go in this file or in .env — use the
# cc-secrets named volume, populated by scripts/gen-secrets.sh before first
# boot. The secret files that scripts/gen-secrets.sh writes:
#
#   mariadb-root         MariaDB root password
#   mariadb-app          MariaDB app user password (read by api + xiaozhi-server)
#   api-jwt-secret       JWT signing secret (careconnect-api)
#   api-internal-token   Internal notify token (xiaozhi-server → api)
#   api-client-key       X-API-Key for the client heartbeat API (POST /api/v1/*)
#   mqtt-signature-key   HMAC key for MQTT credential generation (matches gateway)
#
# Admin accounts are seeded by scripts/bootstrap-admin.sh on first boot.
# Set CC_ADMIN1_* / CC_ADMIN2_* here (or export from your shell) before
# running bootstrap-admin.sh. These are consumed only by that script —
# not read by the running containers.


# ── Registry ──────────────────────────────────────────────────────────────────
# Private image registry. The Jetson must have this in daemon.json
# "insecure-registries": ["localhost:5000"]
REGISTRY=localhost:5000

# Image tag to pull. Pin to a specific digest for reproducible deploys.
# Example: TAG=20260530-arm64
TAG=latest


# ── Domain ────────────────────────────────────────────────────────────────────
# The haizel.online domain is resolved locally by GL.iNet dnsmasq to the
# Jetson's LAN IP on the router subnet.
# Set to a bare IP for Phase 2 testing before the router is configured.
CC_DOMAIN=haizel.online


# ── Database ──────────────────────────────────────────────────────────────────
# User and DB name. Passwords live in cc-secrets volume — never here.
CC_DB_USER=careconnect
CC_DB_NAME=xiaozhi_esp32_server


# ── Ollama (native on Jetson host, NOT a compose service) ─────────────────────
# Containers reach Ollama via the host-gateway alias (Docker injects the
# host IP automatically). Override if Ollama is bound to a non-default address.
# Default: http://host-gateway:11434
CC_OLLAMA_URL=http://host-gateway:11434
CC_OLLAMA_TRIAGE_MODEL=llama3.1:8b-instruct-q4_K_M


# ── XiaoZhi / watcher URLs ────────────────────────────────────────────────────
# WebSocket URL returned to the W1-A firmware via the OTA response.
# Must be reachable from the watcher's Wi-Fi network (GL.iNet LAN).
# LAN-only (no tunnel): use ws://<jetson-lan-ip>:8000/xiaozhi/v1/
# Phase 3+ (haizel.online via GL.iNet dnsmasq): wss://haizel.online/xiaozhi/v1/
CC_XIAOZHI_WS_URL=wss://ws.nexus.warehouse-13.biz/xiaozhi/v1/

# MQTT gateway public endpoint — sent to firmware as host:port (no scheme).
# Must be reachable from the watcher. Default: haizel.online:1883
CC_MQTT_PUBLIC_IP=haizel.online
CC_MQTT_ENDPOINT=haizel.online:1883


# ── Watcher online-window ─────────────────────────────────────────────────────
# Seconds after a heartbeat after which a watcher is considered offline.
# The client heartbeat API (GET /api/v1/watcher/{mac}/status) uses this.
CC_WATCHER_ONLINE_WINDOW_S=120


# ── Admin bootstrap (consumed only by scripts/bootstrap-admin.sh) ─────────────
# Set before running bootstrap-admin.sh on first boot. Not read by containers.
# Use strong passwords (16+ chars). Not stored in images or volumes.
CC_ADMIN1_USERNAME=admin
CC_ADMIN1_PASSWORD=change-me-before-deploy

# Optional second admin account (e.g. on-site operator account)
CC_ADMIN2_USERNAME=operator
CC_ADMIN2_PASSWORD=change-me-before-deploy
