# careconnect web — build-time environment variables
#
# Copy to .env.local for local development, or set in your CI/CD pipeline.
# All NEXT_PUBLIC_* vars are baked into the static export at build time.

# Base URL of the careconnect server (no trailing slash).
# The dashboard uses this to construct device setup URLs shown to operators.
# Default: https://haizel.online
NEXT_PUBLIC_SERVER_BASE=https://haizel.online

# OTA URL for W1-A Watcher device configuration.
# Default: ${NEXT_PUBLIC_SERVER_BASE}/xiaozhi/ota/
NEXT_PUBLIC_OTA_URL=https://ota.nexus.warehouse-13.biz/xiaozhi/ota/
